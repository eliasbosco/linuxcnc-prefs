#******************************************
# X runs on a TR10x2 trapezoidal leadscrew (10 mm dia, 2 mm pitch, single
# start = 2 mm of travel per motor revolution, 1500 mm long). That is a
# QUARTER of the 8 mm lead used on Y and Z, so X needs 4x their step scale
# and a quarter of their velocity for the same motor rpm. X is no longer run
# at the same rpm as the others: Y and Z sit at 100 mm/s = 750 motor rpm,
# while X is held to 16.666667 mm/s = 1000 mm/min = 500 rpm, because it is
# the longest screw and whips first - see the whip note in [JOINT_0].
[AXIS_X]
# MAX_VEL & MAX_ACC need to be twice the corresponding joint value
MAX_VELOCITY = 33.333334
MAX_ACCELERATION = 1000.0
OFFSET_AV_RATIO = 0.5
MIN_LIMIT = 0.0
MAX_LIMIT = 1280.0

[JOINT_0]
TYPE = LINEAR
HOME = 402.837
FERROR = 10.0
MIN_FERROR = 1.0
# 16.666667 mm/s = 1000 mm/min = 500 rpm on a 2 mm lead. DO NOT RAISE THIS
# WITHOUT A MECHANICAL CHANGE FIRST. Tried 50 mm/s (1500 rpm) on 2026-09-02
# together with the Y/Z doubling: Y and Z were fine, but the X screw whipped
# badly and it was reverted the same day. 25 mm/s (750 rpm) was then run until
# 2026-09-04 and still whipped, so X was brought down to 500 rpm, which is
# where it runs quietly. That is the number every other speed on this machine
# is now set to: the jog rate in [DISPLAY], the park feed in park.ngc, the
# travel rewrite in custom_filter.py and dxf2ngc.py, and the cut speeds in
# the material file are all 1000 mm/min.
#
# Why, and why it is not a tuning problem: whip is lateral resonance, not a
# torque or accel limit, so no P/I/D or STEPGEN change touches it. The gantry
# nut is an intermediate lateral support, so the free span - and the critical
# speed - depends on where X is standing. Near either end of travel the span
# is the full ~1500 mm, and first critical for a TR10x2 (7.5 mm root dia) is
# only 396-900 rpm depending on how the end blocks constrain the screw.
# Mid-travel the span halves and critical rises ~4x. So 750 rpm is ALREADY
# at or near critical near the ends; 1500 rpm is far past it everywhere. The
# machine agreed: 750 rpm whipped, and 500 rpm - just above the 396 rpm bottom
# of that band - is the first speed that does not.
#
# Real fixes, in increasing order of work: support the screw mid-span with an
# anti-whip follower, go to a larger-diameter or higher-lead screw (a 16 mm
# ballscrew moves critical up by d/L^2 and needs fewer rpm per mm), or drive X
# by belt or rack and pinion and stop turning a 1.5 m screw at all.
# Acceleration was left alone at 500.
MAX_VELOCITY = 16.666667
MAX_ACCELERATION = 500.0
# The values below should be 25% larger than MAX_VELOCITY and MAX_ACCELERATION
# If using BACKLASH compensation STEPGEN_MAXACCEL should be 100% larger.
STEPGEN_MAXVEL = 20.833334
STEPGEN_MAXACCEL = 625.0
P = 1000.0
I = 0.0
D = 0.0
FF0 = 0.0
FF1 = 1.0
FF2 = 0.0
BIAS = 0.0
DEADBAND = 0.0
MAX_OUTPUT = 0.0
# these are in nanoseconds
DIRSETUP   = 10000
DIRHOLD    = 10000
STEPLEN    = 5000
STEPSPACE  = 5000
# 2000 pulse/rev driver / 2 mm lead = 1000 steps/mm. Was 250 (the 8 mm-lead
# value), which made X travel exactly a quarter of what was commanded.
STEP_SCALE = 1000.0
MIN_LIMIT = 0.0
# Verified on the machine 2026-09-01, after the STEP_SCALE fix made X travel
