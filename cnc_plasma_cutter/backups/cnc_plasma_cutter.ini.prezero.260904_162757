[FILTER]
PROGRAM_EXTENSION = .ngc,.nc,.tap GCode File (*.ngc, *.nc, *.tap)
# A filter turns a non-G-code file into G-code on the fly: LinuxCNC runs
# "<filter> <file>" and loads whatever the filter prints on stdout. Registering
# .dxf here puts a "DXF Drawing" entry in the file manager's type box, so a DXF
# can be opened exactly like an .ngc and is converted on the way in. The DXF
# user button does the same job via its own file chooser - same script.
# Extensions are matched case-sensitively, hence both dxf and DXF.
PROGRAM_EXTENSION = .dxf,.DXF DXF Drawing (*.dxf, *.DXF)
