# Include your custom HAL commands here
# This file will not be overwritten when you run PNCconf again

# ---COMMON PLASMAC DEBOUNCE---
# for the float and ohmic inputs each increment in delay is
# is a 0.001mm (0.00004") increase in any probed height result
setp db_float.delay     5
setp db_ohmic.delay     5
setp db_breakaway.delay 5
# arc-ok: left at 5. Raising it to 20 on 2026-08-11 did NOT stop the
# intermittent "valid arc lost", so it was reverted - debounce was the
# wrong lever and 20 only cost 15 ms of arc-loss detection time.
#
# DIAGNOSIS: the failure happens ONLY on the FIRST arc-ok of a session,
# never on the retries (QtPlasmaC restarts it automatically - see
# "Arc Maximum Starts = 3" / "Arc Restart Delay = 1.0" in the prefs).
# That pattern is WETTING CURRENT, not noise. The HBC65 arc-transfer
# output is a bare dry contact wired straight to gpio.014 with no
# optocoupler, so the only current through it is the 7i92's weak internal
# pull-up - a few hundred microamps. That is far below the milliamps a
# relay contact needs to punch through the oxide film that forms on the
# contact faces while idle. The first closure does not conduct; it scrapes
# the film, so every closure after it works. Debounce cannot fix a
# contact that is not conducting at all.
#
# FIX: 1k from terminal "14" to the 5V on the same 8-way block. That puts
# ~5 mA through the contact, solidly in the wetting range, and as a bonus
# sharpens the release edge and drops the line impedance so HF cannot
# swing it. Prefer 1k over 2.2k here - 2.2k only gives ~2 mA.
setp db_arc-ok.delay    5

# ======================================================================
# THCAD2 ARC VOLTAGE READOUT  (Mesa 7i92 QCount0)
# Confirmed pinout (mesaflash --readhmid):
#   QCount0 Quad-A = GPIO27 = P1 pin 7   <-- THCAD2 P1.4 FOUT+ wires here
#   QCount0 Quad-B = GPIO26 = P1 pin 6   <-- unused (leave open)
#   THCAD2 P1.5 FOUT- -> LEAVE OPEN. Do NOT wire it to GND.
#   THCAD2 P1.6 +5V / P1.1 GND -> clean 5V supply (4.75-5.25V, 65-150mA)
#
# *** FOUT- MUST FLOAT *** FOUT+/FOUT- are a DIFFERENTIAL PAIR - per the
# THCAD2 manual p7, "one output is always just an inverted copy of the
# other", and "if differential mode is not required, either FOUT+ or FOUT-
# may be used as TTL level signals". FOUT- is therefore an ACTIVELY DRIVEN
# push-pull output, NOT a signal return. This comment previously said to
# wire it to a 7i92 GND pin; that shorts a live driver output to ground,
# which collapses the differential stage and leaves FOUT+ sitting at a
# dead ~0.35 V with no logic swing - the pin reads a steady [ low ] and
# the encoder counts NOTHING, while the card looks healthy because its
# CR2 LED is fed from the internal frequency and keeps blinking.
# That cost hours on 2026-08-11. Only P1.1 GND bonds to Mesa ground.
#
# SANITY CHECK WITHOUT ANY INSTRUMENTS (manual p8): CR5 glows steadily =
# isolated input-side 5V present. CR2 blinks at output-frequency/262144,
# i.e. ~0.5 Hz at 0 V input and ~3.3 Hz at full scale. A blinking CR2
# proves the V-to-F core works; it says NOTHING about the output driver
# or the wiring to the FPGA - only climbing .rawcounts proves that.
#   THCAD2 W1 = UP (10V full-scale), 3 x 1M = 3.0M series R on P2.1 IN-
#   VFS = (REXT * 100uA) + 10V = (3.0M * 100uA) + 10 = 310V full scale
#
# *** OUTPUT DIVIDER IS SET TO F/32 *** (jumper W3 IN, W2/W4/W5 OUT - see
# manual p4 "OUTPUT FREQUENCY"). Default from the factory is divide-by-one.
# The counter therefore sees 1/32 of the raw V-to-F frequency, and EVERY
# scaling number below is a /32 number. If the jumper is ever moved back to
# divide-by-one, the scale must go back to 0.0003875 or the THC will read
# 32x low and never make Arc OK Low.
#
# CRITICAL, manual p6: "the calibration data on the THCAD is recorded in the
# divide by one mode". The sticker on the back of the card is ALWAYS raw
# numbers - divide both of them by 32 yourself.
#
# counter-mode 1 = up/down (single-input frequency count) as the THCAD2
# manual requires. scale 1 makes .velocity read directly in Hz; the volts
# conversion is done by QtPlasmaC's THCAD calibration fields, NOT here.
# *** THE OFFSET IS A FREQUENCY IN Hz, NOT A VOLTAGE. ***
# This block used to state that plasmac computes volts = (freq * Scale) +
# Offset. IT DOES NOT, and that error cost most of 2026-08-13. Measured from
# a single simultaneous `halcmd show pin plasmac` snapshot:
#   arc-voltage-in 3128.259 Hz, scale 0.0124, offset -38.75 -> out 39.261 V
#     (in * S) + O  =  0.040 V   err 39.221   <- the old, WRONG formula
#     (in + O) * S  = 38.310 V   err  0.951
#     (in - O) * S  = 39.271 V   err  0.010   <- THIS ONE
# So:
#       volts = (freq_Hz - Offset_Hz) * Scale
# and the Offset is the ZERO-VOLT FREQUENCY, in Hz, subtracted BEFORE
# scaling. It is not a voltage and it is not negative.
#   Scale  =  VFS / (Ffull - Fzero)          [both freqs already /32]
#   Offset =  Fzero                          [Hz, already /32]
#
# Design-centre worked example (100k/900k raw -> /32):
#   Fzero (0V)   = 100000 / 32 = 3125 Hz
#   Ffull (FS)   = 900000 / 32 = 28125 Hz
#   span         = 25000 Hz  ->  310 V
#   Scale  = 310 / 25000 = 0.0124
#   Offset = 3125        (Hz)
#   Fmax voltage = 310   (10V mode, 3 x 1M = 3.0M series on IN-)
# INDEPENDENT CHECK that this reading of the formula is right - put the
# measured Fzero in as the Offset and the top of the range must land on VFS:
#   (28125 - 3128.4) * 0.0124 = 309.96 V   against a design VFS of 310.
# Scale alone was always correct; only the Offset was wrong.
#
# Because Offset is a FREQUENCY it is NOT invariant under the output divider -
# an earlier version of this note claimed it was, on the strength of it being
# a voltage. If W3 ever moves back to divide-by-one, BOTH numbers change:
# Offset goes to ~100000 and Scale to 0.0003875.
#
# *** COUNT MULTIPLIER: SOLVED 2026-08-13 by the 2 MHz sample clock. ***
# ./thcad_zero.sh, torch off, HBC65 idle, after sample-frequency was dropped
# to 2 MHz (see the GLITCH FILTER note below):
#   velocity  mean -3128.1 Hz   min -3134.8   max -3118.5   (43 samples, 5 s)
#   rawcounts -3128.3 Hz over 5.13 s   <- independent of the velocity estimator
#   N = 1.001, spread 16 Hz (0.5%)
# N is now 1 and STEADY, and the two independent measurements agree to 0.01%.
# The wider glitch window fixed the multiple counting: the noisy slow edge was
# being rejected once the filter needed 7.5 us instead of 0.5 us in each state.
# Confirmed again at 17:00 and 17:02 the same day, 162-166 samples over 20 s,
# N = 1.001 both times. The counting has been clean in EVERY session that was
# actually sampled - the "39" on the ARC box was never the multiplier, it was
# the Offset units error above. Do not re-open this unless thcad_zero.sh says
# N is off 1.
#
# HISTORY - the multiple counting that this replaced. Keep it: if the ARC box
# ever reads a clean multiple of the true voltage again, this is the cause.
# Torch-off frequency measured on 2026-08-13, true input 0 V, three times:
#   design-centre prediction   3125 Hz   = 1.000 x
#   at first calibration       6270 Hz   = 2.006 x
#   a few runs later           9485 Hz   = 3.035 x
# Two independent readings landing within 1.2% of EXACT INTEGER multiples of
# the design-centre Fzero is not tolerance. The card is almost certainly fine
# and emitting its spec'd ~3125 Hz at 0 V; hostmot2 is registering a whole
# number of counts per output cycle - 2 that day, 3 the next - so the reading
# is N * Fzero with N wandering.
#
# CONSEQUENCE: a two-point fit is worthless here. It photographs whichever N
# was live when you took the points. A fit made at N=2 (scale 0.0108855,
# offset -68.25) put torch-off at 0 V that afternoon and at 35 V once N went
# to 3. Reverted for exactly that reason. Fit only AFTER N is pinned at 1.
#
# LIKELY CAUSE: signal integrity on the single-ended FOUT+ run. A ringing or
# slow edge gets counted more than once, and how many times depends on the
# wiring, the routing and the noise floor - which is why it changes between
# sessions and why it changed when FOUT+ was moved to the correct Mesa pin.
# encoder.00.filter is already TRUE (15 sample clocks) and is NOT enough.
#
# SEEN ON SCREEN 2026-08-13, torch off and HBC65 idle: the ARC box read 39.
# RESOLVED - it was the Offset units error at the top of this block, nothing
# else. With Offset = -38.75 the maths is (3128 - (-38.75)) * 0.0124 = 39.27,
# so a PERFECTLY healthy 3128 Hz displays as 39. It sat at 39 through the abs
# fix, the scale sign flip and the 2 MHz sample clock because every one of
# those is upstream of a frequency that was already correct.
# Corroboration from an older note further down this file: "arc-voltage-out
# pins near zero (measured ~0.5 V with no signal at all)". Under the correct
# formula a dead counter with Offset -38.75 gives (0 + 38.75) * 0.0124 =
# 0.48 V. That observation was right and nobody could explain it at the time.
# Run ./thcad_zero.sh (LinuxCNC up, torch off) to re-check any of this - it
# samples the encoder, prints the implied N and names the fault.
#
# DECISIVE TEST, torch off, costs a minute:
#   DVM in Hz mode on FOUT+ referenced to P1.1 GND, next to a live read of
#   hm2_7i92.0.encoder.00.velocity.
#     meter ~3.1 kHz, HAL ~3.1 kHz -> counting is clean, calibrate normally
#     meter ~3.1 kHz, HAL ~6.3/9.5 -> multiple counts per cycle, FIX THE WIRE
#     meter ~9.5 kHz               -> the card really is emitting that, so
#                                     the divider is not running /32
# FIXES IF IT IS MULTIPLE-COUNTING: shorten/screen the FOUT+ run, keep it off
# the torch and stepper looms, add a series resistor (~100R) at the source
# and/or a small cap at the FPGA to slow the edge, or drive it properly
# differentially. Re-fit only once the reading is stable across restarts.
#   NOTE: 1M parts are often +-5%, so real total may be ~2.85-3.15M
#   (VFS ~295-325V). Fold this in when the real calibration finally happens.
# WIDEN THE GLITCH FILTER (attempt at the wandering count multiplier above).
# encoder.00.filter is a BIT, not a width - True = 15 sample clocks, False =
# 3, and True is already the aggressive setting. The only way to lengthen the
# window is to slow the sample clock the 15 counts are measured against.
# Default 25-33 MHz -> 15 clocks = only 0.45-0.6 us, against a signal whose
# period at 0 V is 320 us. Anything double-counting us is evidently WIDER
# than 0.6 us, so the stock filter never sees it - which points at a slow,
# noisy edge crossing the logic threshold several times, not fast ringing.
#   2 MHz -> 15 clocks = 7.5 us glitch rejection (12-16x the stock window)
# Ceiling check: the filter needs 15 clocks in EACH state, so max countable
# is Fs/30 = 66.7 kHz. Full scale here is 28125 Hz (310 V), so 2.37x margin.
# DO NOT drop to 1 MHz - that gives only 1.19x and would clip near full-scale
# arc voltage, silently capping the reading at the top of the cut range.
# Global to all standard encoder channels; encoder.00 is the only one in use.
#
# *** DISABLED 2026-08-13 17:20 - IT WAS THE CAUSE OF THE ARC-TIME COUNTER
# *** FREEZE. CONFIRMED BY MEASUREMENT. DO NOT PUT IT BACK.
# Back-to-back captures, same machine, same torch, ~10 minutes apart:
#   2 MHz  (17:14): counter FROZE at 346468 for 1.41 s during the arc,
#                   16 consecutive zero deltas, ARC box stuck at -38.79 V
#   default(17:23): 46 torch-on samples, frequency tracked 3342 -> 13757 Hz,
#                   arc volts 2.5 -> 131.8, steady cut 125-132 V,
#                   ZERO frozen samples, ZERO negative deltas
# And the multiplier did NOT return at the default width: thcad_zero.sh at
# 17:22 gave N = 1.001 over 161 samples with sample-frequency=25000000.
# So the wide filter was never needed in the first place. The 2x/3x counting
# it was meant to cure had almost certainly already been fixed by moving FOUT+
# to the correct Mesa pin - the filter change happened at the same time and
# wrongly took the credit.
# thcad_arc_log.sh caught a cut at 17:14: the counter counted normally up to
# 8654 Hz as the voltage rose, then rawcounts FROZE at 346468 for 1.41 s while
# the arc was live - 16 consecutive samples with delta exactly 0, and the
# velocity estimator decaying 8.2 -> 4.8 -> 3.3 -> 2.5 -> 0 with no new counts.
# Zero negative deltas in 498 samples, so this is NOT the floating-Quad-B
# direction flip; no edges are arriving at all.
# MECHANISM: filter=TRUE needs the input to HOLD each state for 15 sample
# clocks. At 2 MHz that is 7.5 us. Continuous arc hash that toggles the line
# faster than 7.5 us means no state ever persists long enough to register and
# the counter stops dead. At the stock 25-33 MHz the window is 0.45-0.6 us,
# roughly 13x more tolerant of fast noise - which is why the wide filter that
# cured the multiple counting at IDLE is exactly the wrong setting under HF.
# The two faults want opposite filter widths, so if the multiplier returns the
# answer is NOT to re-widen this - it is to fix the signal (screen/reroute the
# FOUT+ run off the torch loom, series R at the source, or go differential).
# CHECK AFTER CHANGING THIS: ./thcad_zero.sh torch off (N must be ~1.00) AND
# ./thcad_arc_log.sh across a real cut (must not freeze).
#setp hm2_7i92.0.encoder.sample-frequency 2000000
setp hm2_7i92.0.encoder.00.counter-mode 1
# *** THE COUNT DIRECTION IS NOT STABLE - DO NOT CHASE IT WITH scale. ***
# hostmot2 man page, counter-mode: "Set to True for Step/Dir (in which case
# Step is on the A pin and Dir is on the B pin)." Quad-B is GPIO26 and it is
# DELIBERATELY UNWIRED (only FOUT+ feeds Quad-A), so the direction input is a
# floating CMOS pin and the counter picks a direction from whatever that pin
# happens to settle at. It has now been observed BOTH ways:
#   scale +1 -> velocity NEGATIVE  (2026-08-11, counter running down)
#   scale -1 -> velocity NEGATIVE  (2026-08-13, counter running up)
# Same symptom, opposite hardware state. Every time the sign was "fixed" by
# flipping this scale, it came back inverted after a restart - flipping scale
# only ever encodes which way GPIO26 floated on the day it was measured.
#
# WHY IT MATTERS: volts = (freq - Offset) * Scale, so a negative frequency
# drives the reading hard negative - at -3128 Hz with the correct Offset of
# 3128 that is (-3128 - 3128) * 0.0124 = -77.6 V. The reading then sits far
# below Arc OK Low = 60, and in Mode 1 the whole thing looks like an arc-ok
# input fault rather than a sign error.
# (The -78 V figure was never actually SEEN on the ARC box - it was predicted
# with the old wrong formula. What the box showed at -3128 Hz was -39.)
#
# FIX: take the magnitude and stop caring. The THCAD emits a FREQUENCY; a
# frequency is never negative, so |velocity| is the true reading in EVERY
# direction state and nothing downstream can be inverted by GPIO26 again.
# scale is back to the LinuxCNC-documented +1 for the THCAD (see the
# plasma-5i20 sample config) - with abs in the path its sign is irrelevant.
#
# REAL FIX, when there is a soldering iron to hand: tie GPIO26 (P1 pin 6) to
# a defined level so the direction input stops floating. Try 1k to GND first,
# re-run ./thcad_zero.sh, and if it counts down instead, move it to +3.3V.
# abs stays in either way - it costs one float op and removes the failure
# mode permanently.
setp hm2_7i92.0.encoder.00.scale        1

loadrt abs count=1
addf   abs.0  servo-thread
# custom.hal is the LAST halfile (see the ini), so abs.0 lands after plasmac
# in the servo thread and the voltage plasmac reads is one servo period old.
# 1 ms against "THC Sample Counts = 50" (50 ms of averaging) is nothing, and
# comp.0 further down this file already runs with the same one-period lag.
net  thcad-freq-raw          <=  hm2_7i92.0.encoder.00.velocity
net  thcad-freq-raw          =>  abs.0.in
net  plasmac:arc-voltage-in  <=  abs.0.out
# ======================================================================

# ======================================================================
# TORCH START OUTPUT  (Mesa 7i92 -> relay/opto -> HBC65 control pins 1,2)
# HBC65 start input expects a DRY CONTACT closure. Do NOT drive it from the
# 3.3V FPGA pin directly - use a relay or opto between GPIO30 and HBC65 1,2.
#   torch-on -> GPIO30 = P1-10  (was GPIO22 = P1-16, the terminal silked "22"
#   on the 4-way block by the LinuxCNC logo: 22 24 29 G)
# gpio.030 has secondary function "None" in the card IDROM, so it stays a
# plain GPIO regardless of the num_pwmgens/num_stepgens/num_encoders config
# (the PWM lives on gpio.001 = P2-14, the THCAD encoder on gpio.026/027).
#
# NOTE the signal is plasmac:torch-on, the plasmac component OUTPUT - NOT
# spindle.0.on. spindle.0.on is plasmac's INPUT (plasmac:cutting-start, the
# raw M3); driving the relay from it would fire the torch the moment M3 is
# issued and hold it on regardless of Torch Enable, pierce delay, arc-ok,
# arc loss, cut recovery or M62 P3 torch-off. See qtplasmac_comp.hal.
#
# NOTE this board is an F7192_V2.2 clone, NOT a genuine 7i92. The silk numbers
# ARE the hostmot2 GPIO indices. The only numbered terminals it breaks out are
# 14-19 (8-way block, with G and 5V) and 22/24/29 (4-way block); GPIO28 (P1-08)
# is a real pin but has no screw terminal, which is why gpio.028 did nothing.
# GPIO30 is likewise on P1 with no silked terminal - take it off the P1 header
# / D-sub, not the screw blocks.
# Connector map is per "mesaflash --device 7i92 --addr 10.10.10.10 --readhmid":
# GPIO 000-016 = P2 (DB25 order 1,14,2,15,3,16,4,17,5..13), GPIO 017-033 = P1.
# Use ./pin_probe.sh to walk the free pins and find them with a meter.
setp hm2_7i92.0.gpio.030.is_output  1
net  plasmac:torch-on  =>  hm2_7i92.0.gpio.030.out
# ======================================================================

# ======================================================================
# HARDWARE ARC-OK INPUT  (HBC65 control pins 3,4 -> PC817 -> Mesa)
#   arc-ok <- GPIO14 = P2-11 = the terminal silked "14" on the 8-way block
#             (the one with G and 5V, silked: 5V G 14 15 16 17 18 19)
#
# INVERTED (.in_not) because this input is ACTIVE LOW - confirmed on the
# bench with ./gpio_watch.sh: gpio.014 idles at a steady HIGH on the board's
# pull-up, and the PC817's phototransistor pulls it DOWN to ground when the
# arc-established contact closes, so the row flips [ HIGH ] -> [  low ].
# .in_not therefore reads FALSE with no arc and TRUE with an arc.
#
# This is also the fail-safe polarity: a broken wire or a dead / unpowered
# opto leaves the pin pulled HIGH, i.e. arc-ok FALSE, so a failure reads as
# "no arc" and the machine stops rather than cutting on a phantom arc.
#
# NOTE the signal must be plasmac:arc-ok-in (the debounce INPUT). Do NOT use
# plasmac:arc-ok - that is the debounce OUTPUT and is already driven, so it
# would cause a "signal already has writer" HAL error / bypass the debounce.
# Debounce delay is set at the top of this file (db_arc-ok.delay = 5).
#
# This pin is read in Mode 1 and Mode 2 only - Mode 0 derives Arc-OK from
# the arc-voltage threshold alone and ignores it. cnc_plasma_cutter.prefs is
# now set to "Mode = 1" under [GUI_OPTIONS], so this wiring is live.
# NOTE Mode has NO GUI control: qtplasmac_handler.py reads it once at
# startup (getpref 'Mode', GUI_OPTIONS) and never writes it back, so it can
# only be changed by editing the prefs file with QtPlasmaC CLOSED.
setp hm2_7i92.0.gpio.014.is_output  0
net  plasmac:arc-ok-in  <=  hm2_7i92.0.gpio.014.in_not
# ======================================================================

# ======================================================================
# TEMPORARY BENCH-TEST FLOAT-SWITCH SIMULATION  *** DISABLED ***
# *** The REAL float switch on gpio.015 is now live in the next block. To go
# *** back to air-only dry runs, uncomment the five lines at the end of this
# *** block and comment out the two lines at the end of the next one. Only
# *** ONE of the two may be active - both write plasmac:float-switch, and two
# *** writers on one signal is a "signal already has writer" HAL error.
#
# This makes QtPlasmaC's touch-off probe succeed at a VIRTUAL material top
# of Z = -40 mm so the X/Y/Z cut motion can be verified in the air. (-40
# leaves >25 mm of room above the material so QtPlasmaC's 25 mm "Safe
# Height" fits without the "safe traverse height reduced" warning. Raise
# the GUI Probe Feed Rate to keep the 40 mm probe descent quick.)
#
# The float switch reads "not tripped" at Z=0 and trips once Z descends
# below -40 mm (comp.out is true when in1 > in0, i.e. -40 > Z).
#
# For a FULL dry run also set this in the QtPlasmaC GUI:
#   * DISABLE the Torch (Torch Enable off) - QtPlasmaC then auto-simulates
#     arc-OK and runs all motion without firing. (Optionally disable THC too.)
#
#loadrt comp count=1
#addf   comp.0  servo-thread
#setp   comp.0.in1   -40.0      # virtual material top (mm)
#setp   comp.0.hyst    1.0
#net    plasmac:axis-position  =>  comp.0.in0   # live machine Z position
#net    plasmac:float-switch   <=  comp.0.out   # drive the simulated float switch
# ======================================================================

# ======================================================================
# REAL FLOAT SWITCH INPUT  (torch breakaway/float probe -> Mesa)  *** ACTIVE ***
# This is what QtPlasmaC probes with when the Torch is ENABLED - the virtual
# -40 mm simulation above is now commented out.
#
#   float-switch <- GPIO15 = P2-12 = the terminal silked "15" on the 8-way
#                   block (5V G 14 15 16 17 18 19), i.e. the pin next to the
#                   arc-ok input on 14. See mesa_F7I92_pinout.txt.
#
# Wiring: one side of the switch to a G terminal on the same 8-way block,
# the other side to terminal 15. The board pulls the pin up, so an open
# switch reads HIGH and a closed switch reads LOW. NOTE this pin is on the
# INPUT-BUFFERED 8-way block - it reads fine but cannot be driven as an
# output, so do not try to source a test signal from it.
#
# POLARITY: INVERTED (.in_not), set 2026-08-14 after the bench check showed
# plain .in reading backwards - float-switch was TRUE at rest. So the fitted
# switch is NORMALLY-OPEN: open at rest (pin pulled HIGH, .in_not FALSE =
# "not tripped"), closing when the torch head is pushed up on contact with
# the material (pin LOW, .in_not TRUE = "tripped").
#
# *** THIS IS NOT THE FAIL-SAFE POLARITY. *** A broken wire, a disconnected
# plug or a lost connection leaves the pin pulled HIGH, which reads as "not
# tripped" - so a probe will keep driving the torch down into the plate
# until the Z limit instead of stopping. The fail-safe alternative is a
# NORMALLY-CLOSED switch read with plain .in (closed at rest -> pin LOW ->
# "not tripped"; any break -> pin HIGH -> "tripped" -> probe stops at once).
# If this float switch has an NC contact available, moving to it and
# reverting this line to .in is the safer wiring.
#
# VERIFY BEFORE PROBING: with the machine on, watch ./gpio_watch.sh (or the
# QtPlasmaC Float LED) and push the torch head up by hand. The LED must be
# OFF at rest and ON while lifted. Debounce delay is db_float.delay = 5 at
# the top of this file (each increment adds 0.001 mm to the probed height).
setp hm2_7i92.0.gpio.015.is_output  0
net  plasmac:float-switch  <=  hm2_7i92.0.gpio.015.in_not
# ======================================================================



########################################
# The following variables are available for fine tuning some parameters.
# To use any of these, uncomment the required setp line and set an appropriate value.

# Dampen excessive noise on the arc voltage input
# default = 0 (volts)
#setp plasmac.lowpass-frequency 0

# The time delay from losing the arc ok signal until QtPlasmaC reacts to the arc loss.
# default = 0.0 (seconds)
#setp plasmac.arc-lost-delay 0.0

# For mode 0 Arc-OK only, the number of consecutive readings within the threshold that are required to set the Arc-OK signal.
# default = 6
#setp plasmac.arc-ok-counts 6

# For mode 0 Arc-OK only, the maximum voltage deviation that is allowed for a valid voltage to set the Arc OK signal.
# default = 10 (volts)
#setp plasmac.arc-ok-threshold 10

# The voltage above and below 0V that will display as 0V. Prevents small fluctuations from flickering the voltage display.
# default = 0 (volts)
#setp plasmac.zero-window 0

# The distance (in millimeters) away from the Z MAX_LIMIT that QtPlasmaC will allow the Z axis to travel while under machine control.
# default = 5 (mm)
#setp plasmac.max-offset 5

# The required number of consecutive times that the threshold has been exceeded before applying the void lock to the THC.
# default = 2
#setp plasmac.kerf-error-max 2
